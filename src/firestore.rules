rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Your existing Users rule
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Your existing Profit Ledger rule (restricted to owners)
    match /profitLedger/{entry} {
      allow read: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner";
      allow write: if false; 
    }
    
    // Your existing Invoices rule
    match /invoices/{invoice} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────
    // NEW RULES ADDED FOR PHASE 3, 4, 5, AND 6 TO WORK:
    // ─────────────────────────────────────────────────────────────

    // Customers (User Management & Reports)
    match /customers/{customer} {
      allow read, write: if request.auth != null;
    }

    // Suppliers (Supplier Management)
    match /suppliers/{supplier} {
      allow read, write: if request.auth != null;
    }

    // Staff (Staff Management & Staff Ledger)
    match /staff/{staffMember} {
      allow read, write: if request.auth != null;
    }

    // Receipts & Ledgers (Phase 6)
    match /receipts/{receipt} {
      allow read, write: if request.auth != null;
    }
    match /accountLedger/{entry} {
      allow read, write: if request.auth != null;
    }

    // Outstanding Balances (Phase 6)
    match /outstandings/{outstanding} {
      allow read, write: if request.auth != null;
    }

    // Payment Vouchers (Phase 5)
    match /supplierPaymentVouchers/{voucher} {
      allow read, write: if request.auth != null;
    }

    // Cancellations & Bank Ledgers
    match /cancellations/{cancellation} {
      allow read, write: if request.auth != null;
    }
    match /bankLedger/{transaction} {
      allow read, write: if request.auth != null;
    }
  }
}